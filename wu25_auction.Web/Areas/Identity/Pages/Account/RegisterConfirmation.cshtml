@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Bekräfta konto";
}

<div class="auth-container">
    <h1 class="auth-title">Bekräfta konto</h1>

    @if (Model.DisplayConfirmAccountLink)
    {
        <p class="product-description">
            Detta är en utvecklingsmiljö och inget e-postsystem är konfigurerat.
        </p>

        <a id="confirm-link"
           href="@Model.EmailConfirmationUrl"
           class="auth-button"
           style="text-align:center; display:block;">
            Bekräfta konto
        </a>
    }
    else
    {
        <p class="product-description">
            Ett bekräftelsemail har skickats till din e-postadress.
            Följ länken i mailet för att aktivera ditt konto.
        </p>
    }

    <a asp-page="./Login" class="auth-link">
        Tillbaka till inloggning
    </a>
</div>