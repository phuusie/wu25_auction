@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="row">
    <div class="row">
        <div class="auth-container">
            <h1 class="auth-title">Log in</h1>

            <form method="post" class="auth-form">
                <input asp-for="Input.Email"
                       class="auth-input"
                       placeholder="Email" />

                <input asp-for="Input.Password"
                       class="auth-input"
                       placeholder="Lösenord"
                       type="password" />

                <div class="remember-wrapper">
                    <label class="remember-label">
                        <input asp-for="Input.RememberMe" class="remember-checkbox" />
                        <span class="remember-text">Kom ihåg mig</span>
                    </label>
                </div>

                <button type="submit" class="auth-button">
                    Logga in
                </button>
            </form>

            <a asp-page="./Register" class="auth-link">
                Skapa konto
            </a><br/>
            <a asp-page="./ForgotPassword" class="auth-link auth-link-muted">
                Glömt lösenord?
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}