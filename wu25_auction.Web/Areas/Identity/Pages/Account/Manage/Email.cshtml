@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="account-layout">
    <div class="account-header">
        <h1 class="account-title">Email</h1>
        <p class="account-subtitle">Hantera email adress</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form method="post" class="profile-form">
        <div class="profile-grid">

            <div class="email-current full">
                <input asp-for="Email"
                       class="auth-input"
                       disabled />

                @if (Model.IsEmailConfirmed)
                {
                    <span class="email-confirmed">Verified</span>
                }
                else
                {
                    <button type="submit"
                            asp-page-handler="SendVerificationEmail"
                            class="email-verify-link">
                        Skicka verifikation
                    </button>
                }
            </div>

            <input asp-for="Input.NewEmail"
                   class="auth-input full"
                   placeholder="New email address" />

        </div>

        <button type="submit"
                asp-page-handler="ChangeEmail"
                class="auth-button confirm">
            Updatera
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}