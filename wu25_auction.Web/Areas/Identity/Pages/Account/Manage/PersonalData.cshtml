@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personuppgifter";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="account-layout">
    <div class="account-header">
        <h1 class="account-title">Personuppgifter</h1>
        <p class="account-subtitle">Ladda ner eller radera ditt konto</p>
    </div>

    <div class="personal-data-content">
        <p class="personal-text">
            Ditt konto innehåller personuppgifter som du har lämnat till oss.
            Här kan du ladda ner eller radera dessa uppgifter.
        </p>

        <p class="personal-warning">
            Att radera dina uppgifter innebär att ditt konto tas bort permanent
            och inte kan återställas.
        </p>

        <form asp-page="DownloadPersonalData" method="post">
            <button type="submit" class="auth-button confirm">
                Ladda ner uppgifter
            </button>
        </form>

        <a asp-page="DeletePersonalData" class="personal-delete-link">
            Radera konto
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}