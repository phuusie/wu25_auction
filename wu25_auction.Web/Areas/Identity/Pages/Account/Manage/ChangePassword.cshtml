@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="account-layout">
    <div class="account-header">
        <h1 class="account-title">Lösenord</h1>
        <p class="account-subtitle">Ändra lösenord</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form method="post" class="profile-form">
        <div class="profile-grid">

            <input asp-for="Input.OldPassword"
                   type="password"
                   class="auth-input full"
                   placeholder="Nuvaranade lösenord" />

            <input asp-for="Input.NewPassword"
                   type="password"
                   class="auth-input full"
                   placeholder="Nytt lösenord" />

            <input asp-for="Input.ConfirmPassword"
                   type="password"
                   class="auth-input full"
                   placeholder="Bekräfta nytt lösenord" />

        </div>

        <button type="submit" class="auth-button confirm">
            Updatera
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}