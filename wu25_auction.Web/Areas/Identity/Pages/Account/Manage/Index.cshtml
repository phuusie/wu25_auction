@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="account-layout">
    <div class="account-header">
        <h1 class="account-title">Profil</h1>
        <p class="account-subtitle">Personlig information</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form method="post" class="profile-form">
        <div class="profile-grid">
            <input asp-for="Input.FirstName" class="auth-input" placeholder="Namn" />
            <input asp-for="Input.LastName" class="auth-input" placeholder="Efternamn" />

            <input asp-for="Input.Street" class="auth-input full" placeholder="Gatuadress" />

            <input asp-for="Input.PostalCode" class="auth-input" placeholder="Postkod" />
            <input asp-for="Input.City" class="auth-input" placeholder="Stad" />

            <input asp-for="Input.Country" class="auth-input full" placeholder="Land" />
            <input asp-for="Input.PhoneNumber" class="auth-input full" placeholder="Telefon" />
        </div>

        <button type="submit" class="auth-button confirm">
            Spara
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}