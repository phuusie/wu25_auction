@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Tvåfaktorsautentisering";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="account-layout">
    <div class="account-header">
        <h1 class="account-title">Tvåfaktorsautentisering</h1>
        <p class="account-subtitle">Extra säkerhet för ditt konto</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    @{
        var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    }

    @if (consentFeature?.CanTrack ?? true)
    {
        @* Status för återställningskoder *@
        @if (Model.Is2faEnabled)
        {
            <div class="twofactor-status">

                @if (Model.RecoveryCodesLeft == 0)
                {
                    <p class="twofactor-warning">
                        Du har inga återställningskoder kvar.
                        <a asp-page="./GenerateRecoveryCodes">Skapa nya koder</a>
                    </p>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <p class="twofactor-warning">
                        Du har @Model.RecoveryCodesLeft återställningskoder kvar.
                        <a asp-page="./GenerateRecoveryCodes">Skapa nya koder</a>
                    </p>
                }

                @if (Model.IsMachineRemembered)
                {
                    <form method="post" class="inline-form">
                        <button type="submit" class="auth-link">
                            Glöm den här webbläsaren
                        </button>
                    </form>
                }

                <div class="twofactor-actions">
                    <a asp-page="./Disable2fa" class="auth-link">Inaktivera 2FA</a>
                    <a asp-page="./GenerateRecoveryCodes" class="auth-link">Återställ koder</a>
                </div>
            </div>
        }

        <div class="twofactor-section">
            <h2 class="section-title">Autentiseringsapp</h2>

            @if (!Model.HasAuthenticator)
            {
                <a asp-page="./EnableAuthenticator" class="auth-button confirm">
                    Lägg till autentiseringsapp
                </a>
            }
            else
            {
                <div class="twofactor-actions">
                    <a asp-page="./EnableAuthenticator" class="auth-link">
                        Konfigurera autentiseringsapp
                    </a>
                    <a asp-page="./ResetAuthenticator" class="auth-link">
                        Återställ autentiseringsapp
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <p class="twofactor-warning">
            Du måste acceptera sekretess- och cookiepolicyn innan du kan aktivera tvåfaktorsautentisering.
        </p>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}