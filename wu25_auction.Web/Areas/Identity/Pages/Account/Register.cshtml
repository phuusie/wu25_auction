@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row">
    <div class="row">
        <div class="auth-container">
            <h1 class="auth-title">Skapa konto</h1>

            <form method="post" class="auth-form">
                <input asp-for="Input.Email" class="auth-input" placeholder="Email"/>
                <input asp-for="Input.Password" class="auth-input" placeholder="Lösenord" type="password"/>
                <input asp-for="Input.ConfirmPassword" class="auth-input" placeholder="Bekräfta lösenord" type="password"/>

                <button type="submit" class="auth-button">
                    Registrera
                </button>
            </form>

            <a asp-page="./Login" class="auth-link">
                Redan registrerad
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}