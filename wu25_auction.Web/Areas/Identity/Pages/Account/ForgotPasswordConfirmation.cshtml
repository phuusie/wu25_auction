@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Kontrollera din e-post";
}

<div class="auth-container">
    <h1 class="auth-title">Kontrollera din e-post</h1>

    <p class="auth-hint">
        Om en användare med denna e-postadress finns,
        har vi skickat en länk för att återställa lösenordet.
    </p>

    <a asp-page="./Login" class="auth-button confirm">
        Tillbaka till inloggning
    </a>
</div>