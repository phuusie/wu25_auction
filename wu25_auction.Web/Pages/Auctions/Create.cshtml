@page
@model CreateModel

@{
    ViewData["Title"] = "Skapa objekt";
}

<div class="account-layout">
    <div class="account-header">
        <h1 class="account-title">Skapa objekt</h1>
        <p class="account-subtitle">Lägg till ett nytt objekt till auktion</p>
    </div>

    <form method="post" class="auth-form">

        <input asp-for="Item.Title"
               class="auth-input"
               placeholder="Titel" />

        <textarea asp-for="Item.Description"
                  class="auth-input"
                  placeholder="Beskrivning"
                  rows="4"></textarea>

        <input asp-for="Item.Category"
               class="auth-input"
               placeholder="Kategori (t.ex. Dekoration)" />

        <input asp-for="Item.Decade"
               class="auth-input"
               placeholder="Årtionde (t.ex. 1960-tal)" />

        <input asp-for="Item.PurchasePrice"
               class="auth-input"
               placeholder="Inköpspris"
               type="number"
               step="0.01" />

        <input asp-for="Item.StartPrice"
               class="auth-input"
               placeholder="Utgångspris"
               type="number"
               step="0.01" />
        
        <input asp-for="Item.EndsAt"
               class="auth-input"
               type="datetime-local"
               value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" />

        <button type="submit" class="auth-button">
            Skapa objekt
        </button>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}